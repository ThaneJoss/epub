{
  "name": "leafread",
  "description": "叶读 LeafRead · EPUB 在线阅读器",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "wrangler dev",
    "lint": "eslint . --max-warnings=0",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run lint && npm test && wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "dompurify": "3.4.17",
    "eslint": "10.12.0",
    "fflate": "0.8.3",
    "globals": "17.13.0",
    "wrangler": "4.149.0"
  }
}
