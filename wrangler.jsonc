{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "epub",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-23",
  "workers_dev": true,
  "routes": [
    { "pattern": "epub.thanejoss.com", "custom_domain": true }
  ],
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/books/*"],
    "not_found_handling": "404-page"
  },
  "vars": {
    "MAX_EPUB_MB": "100",
    "ALLOWED_HOSTS": ""
  },
  "observability": { "enabled": false }
}
